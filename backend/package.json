    "vector:reindex": "ts-node scripts/manage-indices.ts reindex"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@elastic/elasticsearch": "latest",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "latest",
    "@slack/web-api": "^7.15.2",
    "@types/turndown": "^5.0.6",
    "axios": "^1.16.0",
    "bcryptjs": "latest",
    "casbin": "latest",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "latest",
    "express-rate-limit": "latest",
    "express-session": "latest",
    "helmet": "^8.1.0",
    "jsonwebtoken": "latest",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "passport": "latest",
    "passport-github2": "latest",
    "passport-google-oauth20": "latest",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "stripe": "latest",
