{
  "name": "rbhu-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "build": "prisma generate && tsc",
    "test": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "vector:setup": "ts-node scripts/manage-indices.ts setup",
